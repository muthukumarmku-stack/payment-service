# Normalise line endings in the repository; check out with the platform's native endings.
* text=auto

# Shell scripts must keep LF or they fail on Linux/macOS; Windows scripts keep CRLF.
mvnw      text eol=lf
*.sh      text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary files: never touch.
*.jar     binary
